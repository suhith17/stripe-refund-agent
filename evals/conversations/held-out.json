          "kind": "message",
          "text": "The Friday headphones cost $59.99, but I only want a refund of $8.",
          "expected_stage": "awaiting_confirmation",
          "order_id": "ORD-102",
          "amount_minor": 800
        },
        {
          "kind": "confirm"
        },
        {
          "kind": "repeat"
        }
      ]
