        {
          "kind": "message",
          "text": "I want to keep the headphones and will choose a new amount.",
          "expected_stage": "awaiting_clarification"
        },
        {
          "kind": "message",
          "text": "There is a cosmetic scratch, but they still work. Wait for my amount.",
          "expected_stage": "awaiting_clarification"
        },
        {
          "kind": "message",
          "text": "The packaging was torn too. I have not finished deciding.",
          "expected_stage": "awaiting_clarification"
        },
        {
          "kind": "message",
          "text": "Please keep my original purchase selection while I decide.",
          "expected_stage": "awaiting_clarification"
        },
        {
          "kind": "message",
          "text": "I am ready now. Refund USD 9.",
          "expected_stage": "awaiting_confirmation",
          "order_id": "ORD-102",
          "amount_minor": 900,
          "correction": true
        },
        {
          "kind": "stale_confirm"
        },
        {
          "kind": "confirm"
        }
      ]
