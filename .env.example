# Copy to .env and enter a secret key from your Stripe sandbox locally.
# Never commit .env or paste the key into chat. Empty = offline operation.
STRIPE_SECRET_KEY=
# Relative paths are resolved from the repository root.
DATABASE_PATH=instance/payresolve.db
# Gemini model access (synthetic requests only).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional analysis-only fallback after availability failures; eval ignores it.
GEMINI_FALLBACK_MODEL=
# Chat action loop: 1..10 calls per turn; history is the comparison context mode.
AGENT_TOOL_BUDGET=5
AGENT_CONTEXT_MODE=structured
# Chat-only availability fallback. Enable only after checking model access.
AGENT_FALLBACK_MODEL=
# Provisional local ceiling, shared by chat and conversation evaluation requests.
# Check the project's actual per-model RPM/TPM/RPD quotas in Google AI Studio.
GEMINI_REQUESTS_PER_MINUTE=15
